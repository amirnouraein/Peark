<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Search.passkeys.entitlements, and iCloud: what build.sh signs with
       when Search.provisionprofile carries the iCloud container as well as
       the passkey entitlement. Keep the first part the same as that file. -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.personal-information.location</key><true/>
  <key>com.apple.security.personal-information.addressbook</key><true/>
  <key>com.apple.application-identifier</key><string>YCSSN3RUQT.ai.faezeh.search</string>
  <key>com.apple.developer.team-identifier</key><string>YCSSN3RUQT</string>
  <key>com.apple.developer.web-browser.public-key-credential</key><true/>
  <!-- Sync with iCloud (ICloudSync.swift, SYNC.md in Search-iOS): the
       person's private CloudKit database in this container. -->
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array><string>iCloud.ai.faezeh.search</string></array>
  <key>com.apple.developer.icloud-services</key>
  <array><string>CloudKit</string></array>
  <!-- Development data, the same the iPhone app run from Xcode uses. A
       Developer ID profile only allows Production: switch this back with
       one. build.sh leaves this out if the profile doesn't name it. -->
  <key>com.apple.developer.icloud-container-environment</key><string>Development</string>
  <!-- CloudKit's pushes, so a change on the iPhone arrives without
       waiting. A Developer ID app uses this key, not aps-environment.
       build.sh leaves it out if the profile doesn't carry it. -->
  <key>com.apple.developer.aps-environment</key><string>production</string>
</dict>
</plist>
